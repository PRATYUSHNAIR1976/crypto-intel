# Copy to .env and adjust. .env is git-ignored — never commit real keys.
# Phase 1 uses only PUBLIC market-data endpoints, so no API keys are required.

# Where raw payloads, normalized Parquet, quarantine and the SQLite catalog live
CIP_DATA_DIR=data

# Default universe (canonical BASE-QUOTE form; providers translate to their own format)
CIP_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT
CIP_MARKETS=spot,perp
CIP_INTERVALS=1h,4h,1d
CIP_HISTORY_START=2024-01-01

# OHLCV first. Add derivatives explicitly when wanted: ohlcv,funding,open_interest
CIP_DATASETS=ohlcv

# Read side: per series, the first provider in this list that has data is used.
# Different providers are never mixed within one series.
CIP_SOURCE_PRIORITY=binance,coingecko

# Binance public endpoints (free, no key)
CIP_BINANCE_SPOT_BASE_URL=https://api.binance.com
CIP_BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# CoinGecko public API (free). Key is OPTIONAL: a free "Demo" key raises rate limits.
CIP_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
CIP_COINGECKO_API_KEY=
CIP_COINGECKO_REQUEST_PAUSE_SECONDS=2

# HTTP behaviour — be polite to free endpoints
CIP_HTTP_TIMEOUT_SECONDS=15
CIP_REQUEST_PAUSE_SECONDS=0.15
CIP_RETRY_MAX_ATTEMPTS=4

CIP_LOG_LEVEL=INFO
